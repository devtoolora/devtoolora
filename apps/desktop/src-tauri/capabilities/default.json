{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop window capability.",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:allow-write-file",
    "clipboard-manager:allow-write-text",
    "window-state:default",
    "core:window:allow-set-effects",
    "core:window:allow-set-theme"
  ]
}
